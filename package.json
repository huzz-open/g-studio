{
  "name": "g-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  },
  "scripts": {
    "setup:cn": "node scripts/generation/setup.mjs cn",
    "setup:default": "node scripts/generation/setup.mjs default",
    "test:mirrors": "node --test tests/generation-mirrors.test.mjs",
    "dev": "node scripts/generation/start.mjs dev",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "test:normals": "node --test tests/normal-generator.test.cjs",
    "test:history": "node --test tests/history.test.cjs",
    "test:tabs": "node --test tests/tab-actions.test.cjs tests/default-scene.test.cjs",
    "test:compute": "node --test tests/latest-task.test.cjs",
    "test:shadows": "node --test tests/shadow-model.test.cjs",
    "test:scene-lighting": "node --test tests/scene-lighting.test.cjs tests/scene-environment.test.cjs tests/direction-control.test.cjs tests/default-scene.test.cjs",
    "test:parts": "node --test tests/parts.test.cjs tests/sprite-assets.test.cjs tests/part-preview.test.cjs tests/parameter-defaults.test.cjs tests/image-fit.test.cjs tests/orientation-fit.test.cjs tests/model-repair.test.cjs tests/model-comparison.test.cjs tests/model-comparison-viewport.test.cjs tests/reference-projection.test.cjs tests/preview-display.test.cjs tests/processed-model-cache.test.cjs",
    "preview": "vite preview",
    "dev:web": "vite",
    "dev:gensvc": "node scripts/generation/start.mjs start",
    "generation:download": "node scripts/generation/start.mjs download",
    "test:runtime": "node --test tests/generation-bootstrap.test.mjs tests/generation-launcher.test.mjs tests/generation-options.test.mjs tests/generation-installer.test.mjs",
    "test:connection": "node --import tsx --test tests/generation-connection.test.ts tests/generation-deployment.test.ts",
    "test:uv-mirror": "node --test tests/uv-mirror.test.mjs",
    "generation:doctor": "node scripts/generation/start.mjs doctor",
    "relay:dev": "tsx services/generation-relay/server.ts",
    "relay:start": "tsx services/generation-relay/server.ts",
    "check:relay": "tsc --noEmit -p services/tsconfig.json",
    "test:generation": "node --import tsx --test tests/generation.test.ts"
  },
  "dependencies": {
    "@techstark/opencv-js": "github:TechStark/opencv-js#92e4734",
    "jszip": "^3.10.1",
    "three": "^0.186.1",
    "vue": "^3.5.34",
    "vue-router": "^4.5.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vue-tsc": "^3.2.8"
  }
}
