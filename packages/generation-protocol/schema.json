{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://g-studio.dev/schemas/generation/v1",
  "title": "G-Studio generation protocol v1",
  "$defs": {
    "Info": {
      "type": "object", "additionalProperties": false,
      "required": ["deviceType"],
      "properties": {
        "deviceType": { "enum": ["cpu", "gpu"] },
        "backend": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "Request": {
      "type": "object", "additionalProperties": false,
      "required": ["protocolVersion", "clientRequestId", "providerId", "inputSha256"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "clientRequestId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "providerId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "inputSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "targetFaces": { "type": "integer", "minimum": 1000, "maximum": 40000, "default": 12000 },
        "seed": { "type": "integer", "minimum": 0, "maximum": 2147483647, "default": 12345 },
        "parameters": { "type": "object", "additionalProperties": { "type": "number" }, "maxProperties": 32 }
      }
    },
    "Error": {
      "type": "object", "required": ["error"],
      "properties": { "error": { "type": "object", "required": ["code", "message"], "properties": {
        "code": { "type": "string" }, "message": { "type": "string" }, "retryable": { "type": "boolean" }
      } } }
    },
    "Output": {
      "type": "object", "required": ["id", "mime", "bytes", "sha256"],
      "properties": { "id": { "type": "string" }, "mime": { "const": "model/gltf-binary" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 134217728 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
    },
    "Result": {
      "type": "object", "required": ["protocolVersion", "jobId", "providerId", "inputSha256", "coordinateSystem", "triangles", "bounds", "warnings", "outputs"],
      "properties": {
        "backend": { "type": "string" },
        "protocolVersion": { "const": 1 }, "jobId": { "type": "string" }, "providerId": { "type": "string" },
        "inputSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "coordinateSystem": { "const": "right-handed-y-up" },
        "triangles": { "type": "integer", "minimum": 1, "maximum": 40000 },
        "bounds": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } } },
        "warnings": { "type": "array", "items": { "type": "string" } }, "outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Output" } }
      }
    },
    "Job": {
      "type": "object", "required": ["id", "status", "phase"],
      "properties": {
        "id": { "type": "string" }, "status": { "enum": ["queued", "running", "cancel_requested", "cancelled", "succeeded", "failed", "expired"] },
        "phase": { "type": "string" }, "result": { "$ref": "#/$defs/Result" }, "error": { "type": "object" }
      }
    }
  }
}
