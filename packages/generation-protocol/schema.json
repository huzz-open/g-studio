{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://g-studio.dev/schemas/generation/v1",
  "title": "G-Studio generation protocol v1",
  "$defs": {
    "Info": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deviceType"
      ],
      "properties": {
        "deviceType": {
          "enum": [
            "cpu",
            "gpu"
          ]
        },
        "backend": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "clientRequestId",
        "providerId",
        "inputSha256"
      ],
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "clientRequestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "providerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "inputSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "targetFaces": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 1000000,
          "default": 40000
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "default": 12345
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "maxProperties": 32
        }
      }
    },
    "Error": {
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "Output": {
      "type": "object",
      "required": [
        "id",
        "mime",
        "bytes",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "mime": {
          "const": "model/gltf-binary"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 134217728
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "Result": {
      "type": "object",
      "required": [
        "protocolVersion",
        "jobId",
        "providerId",
        "inputSha256",
        "coordinateSystem",
        "triangles",
        "bounds",
        "warnings",
        "outputs"
      ],
      "properties": {
        "backend": {
          "type": "string"
        },
        "protocolVersion": {
          "const": 1
        },
        "jobId": {
          "type": "string"
        },
        "providerId": {
          "type": "string"
        },
        "inputSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "coordinateSystem": {
          "const": "right-handed-y-up"
        },
        "triangles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "bounds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Output"
          }
        },
        "timings": {
          "$ref": "#/$defs/Timings"
        },
        "strategy": {
          "enum": [
            "resident",
            "staged"
          ]
        },
        "precision": {
          "enum": [
            "fp16",
            "fp32"
          ],
          "description": "Fixed sampling/decoding precision; image encoder precision may be reported separately."
        },
        "instanceId": {
          "type": "string"
        },
        "elapsedSeconds": {
          "type": "number",
          "minimum": 0
        },
        "imageEncoderPrecision": {
          "type": "string",
          "enum": [
            "fp16",
            "fp32"
          ],
          "description": "Fixed at startup; may differ from sampling/decoding precision."
        }
      }
    },
    "Job": {
      "type": "object",
      "required": [
        "id",
        "status",
        "phase"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "cancel_requested",
            "cancelled",
            "succeeded",
            "failed"
          ]
        },
        "phase": {
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/Result"
        },
        "error": {
          "type": "object"
        },
        "timings": {
          "$ref": "#/$defs/Timings"
        }
      }
    },
    "Timings": {
      "type": "object",
      "required": [
        "totalSeconds",
        "queueSeconds",
        "executionSeconds"
      ],
      "properties": {
        "totalSeconds": {
          "type": "number",
          "minimum": 0
        },
        "queueSeconds": {
          "type": "number",
          "minimum": 0
        },
        "executionSeconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "ParameterRange": {
      "type": "object",
      "required": [
        "min",
        "max",
        "default"
      ],
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "default": {
          "type": "number"
        },
        "step": {
          "type": "number"
        },
        "integer": {
          "type": "boolean"
        }
      }
    },
    "Provider": {
      "type": "object",
      "required": [
        "providerId",
        "name",
        "state",
        "parameters"
      ],
      "properties": {
        "providerId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ParameterRange"
          }
        },
        "acceptsJobs": {
          "type": "boolean",
          "description": "When absent, clients only submit to ready providers. Loading submissions share startup preparation."
        },
        "tags": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "推荐",
              "快速",
              "均衡",
              "精细"
            ]
          }
        },
        "strategy": {
          "enum": [
            "resident",
            "staged"
          ]
        },
        "precision": {
          "enum": [
            "fp16",
            "fp32"
          ],
          "description": "Fixed sampling/decoding precision; image encoder precision may be reported separately."
        },
        "preparationSeconds": {
          "type": "number",
          "minimum": 0
        },
        "loadSeconds": {
          "type": "number",
          "minimum": 0
        },
        "warmupSeconds": {
          "type": "number",
          "minimum": 0
        },
        "instanceId": {
          "type": "string"
        },
        "loadCount": {
          "type": "integer",
          "minimum": 1
        },
        "imageEncoderPrecision": {
          "type": "string",
          "enum": [
            "fp16",
            "fp32"
          ],
          "description": "Fixed at startup; may differ from sampling/decoding precision."
        }
      }
    },
    "Capabilities": {
      "type": "object",
      "required": [
        "protocolVersion",
        "providers",
        "limits",
        "targetFaces"
      ],
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "providers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/Provider"
          }
        },
        "limits": {
          "type": "object",
          "required": [
            "inputBytes",
            "inputDimension",
            "outputBytes",
            "concurrency",
            "queue"
          ],
          "properties": {
            "inputBytes": {
              "type": "integer",
              "minimum": 1
            },
            "inputDimension": {
              "type": "integer",
              "minimum": 1
            },
            "outputBytes": {
              "type": "integer",
              "minimum": 1
            },
            "concurrency": {
              "type": "integer",
              "minimum": 1
            },
            "queue": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "targetFaces": {
          "$ref": "#/$defs/ParameterRange"
        }
      }
    }
  }
}
